%%writefile .env.example
# ======================================================================
# PostNetworkInitiative — Vibe Collective API Keys
# ======================================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to GitHub — it's already in .gitignore.
# ======================================================================

# Meta AI (Llama) API Key
# Get yours at: https://ai.meta.com/
META_AI_API_KEY=your_meta_ai_api_key_here

# DeepSeek API Key
# Get yours at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Perplexity API Key
# Get yours at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI API Key (used for Copilot backend)
# Get yours at: https://platform.openai.com/api-keys
COPILOT_API_KEY=your_openai_api_key_here

# ======================================================================
# PostNetworkInitiative Internal Token
# ======================================================================
# This is the API token for authenticating requests to the PNI API.
# Change this to a secure random string in production.
PNI_API_TOKEN=pni_api_secret_vibe_collective

# ======================================================================
# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys
# 3. The application will load them automatically via python-dotenv
# ======================================================================
EOF

# Create .gitignore to protect .env
%%writefile .gitignore
# Environment variables — NEVER commit
.env

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
venv/
.venv/

# JVM / JPype
*.class
*.jar

# OS
.DS_Store
Thumbs.db

# Logs
*.log
decision_log.json
EOF

# Push to GitHub
!git add .env.example .gitignore
!git commit -m "Step 6: Add API key template and .gitignore"
!git push origin main

print("\n✅ Step 6 complete. .env.example and .gitignore pushed to GitHub.")
print("⚠️ .env will NEVER be committed — your API keys are safe.")
